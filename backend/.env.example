# Application settings
APP_NAME=CertMonitor
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Use the same database name, username, and password as in the root .env
DATABASE_URL=postgresql+psycopg://certmonitor:REPLACE_WITH_GENERATED_HEX_PASSWORD@db:5432/certmonitor

# Generate a separate secret with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
